PORT=3000
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
JWT_SECRET=any_long_random_alphanumeric_string_for_jwt_signing
GEMINI_API_KEY=your_google_gemini_api_key

# ImageKit credentials
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id
